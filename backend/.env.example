# Copy this file to ".env" in the backend folder and fill in your values.
# ".env" is ignored by Git, so your passwords never get pushed.

# Supabase: Connect > Session pooler (port 5432)
DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_database_password

# Optional
# JWT_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
# ADMIN_SIGNUP_CODE=edureach-admin
# CORS_ORIGINS=http://localhost:3000,https://edu-reach-one.vercel.app

# Optional email alerts (example: Gmail with an App Password). Leave these out to send in-app alerts only.
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=your_email@gmail.com
# spring.mail.password=your_gmail_app_password
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
